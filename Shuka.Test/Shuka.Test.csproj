<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse packages already restored by Shuka.Windows -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Include source files from Shuka.Windows directly instead of referencing the csproj
         so we don't need to expose internal classes as public -->
    <Compile Include="..\Shuka.Windows\PlaywrightTranslator.cs" />
    <Compile Include="..\Shuka.Windows\LocalLlamaTranslator.cs" />
    <Compile Include="..\Shuka.Windows\TranslatorEngine.cs" />
    <Compile Include="..\Shuka.Windows\WindowsTranslator.cs" />
    <Compile Include="..\Shuka.Windows\LocalAiNotInstalledException.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shuka.Core\Shuka.Core.csproj" />
  </ItemGroup>
</Project>
