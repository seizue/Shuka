<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Shuka.Android.Pages"
       xmlns:controls="clr-namespace:Shuka.Android.Controls"
       x:Class="Shuka.Android.AppShell"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate pages:MainPage}"
                      Route="MainPage" />
        <ShellContent Title="Downloads"
                      ContentTemplate="{DataTemplate pages:DownloadsPage}"
                      Route="DownloadsPage"
                      x:Name="DownloadsContent" />
        <ShellContent Title="History"
                      ContentTemplate="{DataTemplate pages:HistoryPage}"
                      Route="HistoryPage"
                      x:Name="HistoryContent" />
        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate pages:SettingsPage}"
                      Route="SettingsPage"
                      x:Name="SettingsContent" />
    </TabBar>

    <!-- Custom tab bar overlaid at the bottom of the Shell -->
    <Shell.ItemTemplate>
        <DataTemplate />
    </Shell.ItemTemplate>

</Shell>
