<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shuka.Android</RootNamespace>
    <AssemblyName>Shuka.Android</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App identity -->
    <ApplicationId>com.seizue.shuka</ApplicationId>
    <ApplicationVersion>100</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.8</ApplicationDisplayVersion>

    <!-- Android -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shuka.Core\Shuka.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.70" />
  </ItemGroup>

  <!-- App icons, splash screen, fonts -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1117" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\MaterialSymbols.ttf" />
    <MauiFont Include="Resources\Fonts\Pacifico-Regular.ttf" />
    <MauiImage Include="Resources\Images\tab_home.svg" />
    <MauiImage Include="Resources\Images\tab_settings.svg" />
    <MauiImage Include="Resources\Images\tab_downloads.svg" />
    <MauiImage Include="Resources\Images\tab_history.svg" />
    <MauiImage Include="Resources\Images\tab_discover.svg" />
    <MauiImage Include="Resources\Images\lily.svg" />
  </ItemGroup>

  <!-- Android platform resources -->
  <ItemGroup>
    <AndroidResource Include="Platforms\Android\Resources\xml\file_provider_paths.xml" SubType="Designer" />
  </ItemGroup>

  <!-- Debug: always use the auto-generated debug keystore, never require a real one -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>

  <!--
    Release signing — used by CI (keystore provided via GitHub secrets).
    For local development: place shuka.keystore in the repo root and set
    SHUKA_KEY_ALIAS / SHUKA_KEY_PASS / SHUKA_STORE_PASS environment variables,
    or pass them on the command line. Without the keystore the debug key is used.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And Exists('$(MSBuildThisFileDirectory)..\shuka.keystore')">
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\shuka.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(SHUKA_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(SHUKA_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(SHUKA_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

</Project>
