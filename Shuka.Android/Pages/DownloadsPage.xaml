<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Shuka.Android.Controls"
             x:Class="Shuka.Android.Pages.DownloadsPage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Top App Bar ──────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,12,Auto"
              Padding="20,52,20,16"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="110">

            <!-- Icon -->
            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource AccentContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center"
                    Margin="0,0,14,0">
                <Label Text="&#xF090;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource AccentLight}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Title + summary pill -->
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Downloads"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label x:Name="DownloadsSubLabel"
                       Text="Your active &amp; queued novels"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}" />
                <HorizontalStackLayout x:Name="SummaryPill" Spacing="10" IsVisible="False">
                    <!-- In-progress badge -->
                    <Border x:Name="RunningBadge"
                            BackgroundColor="{DynamicResource AccentContainer}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="8,3"
                            IsVisible="False">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="&#xE2C4;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="12"
                                   TextColor="{DynamicResource AccentLight}"
                                   VerticalOptions="Center" />
                            <Label x:Name="RunningLabel"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentLight}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <!-- Done badge -->
                    <Border x:Name="DoneBadge"
                            BackgroundColor="#1A30D158"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="8,3"
                            IsVisible="False">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="&#xE876;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="12"
                                   TextColor="#30D158"
                                   VerticalOptions="Center" />
                            <Label x:Name="DoneLabel"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#30D158"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Clear History -->
            <Border Grid.Column="2"
                    x:Name="ClearHistoryBtn"
                    BackgroundColor="{DynamicResource BgInput}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,8"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="&#xE872;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                    <Label Text="Clear"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearHistoryClicked" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Cancel All -->
            <Border Grid.Column="4"
                    x:Name="CancelAllBtn"
                    BackgroundColor="{DynamicResource BgInput}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,8"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="&#xE5C9;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource Danger}"
                           VerticalOptions="Center" />
                    <Label Text="Cancel All"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource Danger}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelAllClicked" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ── Sub-tabs: Ongoing | Completed ──────────────────── -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="48">

            <!-- Ongoing tab -->
            <Grid Grid.Column="0" x:Name="TabOngoingPill">
                <Label x:Name="TabOngoingLabel"
                       Text="ONGOING"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <BoxView x:Name="TabOngoingBar"
                         HeightRequest="2"
                         VerticalOptions="End"
                         HorizontalOptions="Fill"
                         Margin="20,0" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabOngoingTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Completed tab -->
            <Grid Grid.Column="1" x:Name="TabCompletedPill">
                <Label x:Name="TabCompletedLabel"
                       Text="COMPLETED"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <BoxView x:Name="TabCompletedBar"
                         HeightRequest="2"
                         VerticalOptions="End"
                         HorizontalOptions="Fill"
                         Margin="20,0" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabCompletedTapped" />
                </Grid.GestureRecognizers>
            </Grid>

        </Grid>

        <!-- ── Body ─────────────────────────────────────────── -->
        <Grid Grid.Row="2" x:Name="BodyGrid">

            <!-- ══ ONGOING PANEL ══════════════════════════════ -->
            <Grid x:Name="OngoingPanel">

                <!-- Empty state -->
                <VerticalStackLayout x:Name="OngoingEmptyState"
                                     Spacing="14"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource BgCard}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            WidthRequest="80" HeightRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="&#xE2C4;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="40"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No active downloads"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="Start a download from the Home tab"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Scrollable list — cards injected from code-behind -->
                <ScrollView x:Name="OngoingListScroll" IsVisible="False">
                    <VerticalStackLayout x:Name="OngoingCardList"
                                         Padding="16,20,16,112"
                                         Spacing="12" />
                </ScrollView>

            </Grid>

            <!-- ══ COMPLETED PANEL ════════════════════════════ -->
            <Grid x:Name="CompletedPanel" IsVisible="False">

                <!-- Empty state -->
                <VerticalStackLayout x:Name="CompletedEmptyState"
                                     Spacing="14"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource BgCard}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            WidthRequest="80" HeightRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="&#xE876;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="40"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No completed downloads"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="Finished novels will appear here"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Scrollable list — cards injected from code-behind -->
                <ScrollView x:Name="CompletedListScroll" IsVisible="False">
                    <VerticalStackLayout x:Name="CompletedCardList"
                                         Padding="16,20,16,112"
                                         Spacing="12" />
                </ScrollView>

            </Grid>

        </Grid>

        <!-- Options bottom sheet overlay -->
        <Grid x:Name="OptionsSheetOverlay"
              IsVisible="False"
              BackgroundColor="#88000000"
              Grid.Row="0"
              Grid.RowSpan="3">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOptionsSheetOverlayTapped" />
            </Grid.GestureRecognizers>

            <Border x:Name="OptionsSheet"
                    Margin="12,0,12,16"
                    Padding="14,14,14,10"
                    VerticalOptions="End"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource BgCard}"
                    TranslationY="28"
                    Opacity="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOptionsSheetTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="12">
                    <!-- Title & Subtitle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Options"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="OptionsSheetSubtitle"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="&#xE5CD;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="20"
                               TextColor="{DynamicResource TextMuted}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetCloseTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Option Buttons -->
                    <VerticalStackLayout Spacing="8">
                        <!-- Copy Original Title Option -->
                        <Border x:Name="OptionsSheetCopyTitleBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE14D;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy Original Source Title"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetCopyTitleTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Copy Original Author Option -->
                        <Border x:Name="OptionsSheetCopyAuthorBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE14D;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy Original Source Author"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetCopyAuthorTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Cancel Download Option -->
                        <Border x:Name="OptionsSheetCancelBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE5C9;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource Danger}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Cancel Download"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Danger}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetCancelTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
