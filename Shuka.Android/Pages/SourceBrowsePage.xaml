<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shuka.Android.Pages.SourceBrowsePage"
             BackgroundColor="{DynamicResource BgPage}">

    <!-- Root overlay grid — lets the novel detail sheet slide over the page content -->
    <Grid>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ── Top bar ───────────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,52,16,16"
              BackgroundColor="{DynamicResource BgCard}">
            <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="4,0,12,0"
                    VerticalOptions="Center">
                <Label Text="&#xE5C4;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="24"
                       TextColor="{DynamicResource TextPrimary}"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   x:Name="TitleLabel"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   VerticalOptions="Center" />
            <!-- Translate toggle / View toggle -->
            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                <!-- Translate title toggle -->
                <Border x:Name="TranslateToggleBtn"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="8,0,4,0"
                        VerticalOptions="Center">
                    <Label x:Name="TranslateToggleIcon"
                           Text="&#xE8E2;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="22"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTranslateToggleTapped" />
                    </Border.GestureRecognizers>
                </Border>
                <!-- View toggle: card-list / web-view -->
                <Border x:Name="ViewToggleBtn"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="8,0,4,0"
                        VerticalOptions="Center">
                    <Label x:Name="ViewToggleIcon"
                           Text="&#xE065;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="22"
                           TextColor="{DynamicResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnViewToggleTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- ── Filter pills ──────────────────────────────────── -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource BgCard}"
                StrokeThickness="0"
                Padding="16,0,16,12">
            <HorizontalStackLayout Spacing="8">
                <Border x:Name="PillRecent"  StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="14,6">
                    <Label Text="Recent"  FontSize="12" FontAttributes="Bold">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnRecentTapped"/></Label.GestureRecognizers>
                    </Label>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRecentTapped"/></Border.GestureRecognizers>
                </Border>
                <Border x:Name="PillPopular" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="14,6">
                    <Label Text="Popular" FontSize="12" FontAttributes="Bold">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnPopularTapped"/></Label.GestureRecognizers>
                    </Label>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPopularTapped"/></Border.GestureRecognizers>
                </Border>
                <Border x:Name="PillTop500" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="14,6" IsVisible="False">
                    <Label Text="Top 500" FontSize="12" FontAttributes="Bold">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTop500Tapped"/></Label.GestureRecognizers>
                    </Label>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTop500Tapped"/></Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </Border>

        <!-- ── Search bar ────────────────────────────────────── -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource BgCard}"
                StrokeThickness="0"
                Padding="16,0,16,14">
            <Border Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{DynamicResource BgInput}"
                    Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="&#xE8B6;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="18"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"
                           Margin="0,0,8,0" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search novels..."
                           Keyboard="Text"
                           HeightRequest="44"
                           ReturnType="Search"
                           Completed="OnSearchCompleted" />
                    <Label Grid.Column="2"
                           x:Name="SearchClearBtn"
                           Text="&#xE5CD;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="18"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchClearTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </Border>

        <!-- ── Novel list ─────────────────────────────────────── -->
        <Grid Grid.Row="3" x:Name="BodyGrid">

            <!-- Loading spinner -->
            <VerticalStackLayout x:Name="LoadingState"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True" Color="{DynamicResource AccentLight}"
                                   WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..."
                       FontSize="13"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Empty state -->
            <VerticalStackLayout x:Name="EmptyState"
                                 IsVisible="False"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Label Text="&#xE8B6;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="48"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />
                <Label Text="No novels found"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Scrollable novel grid -->
            <ScrollView x:Name="ListScroll" IsVisible="False">
                <VerticalStackLayout x:Name="NovelList"
                                     Padding="16,12,16,40"
                                     Spacing="10" />
            </ScrollView>

            <!-- Image context menu (long-press on cover) — same actions as Shuka Quest -->
            <Grid x:Name="ImageContextMenuOverlay"
                  IsVisible="False"
                  BackgroundColor="#88000000"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImageContextMenuOverlayTapped" />
                </Grid.GestureRecognizers>

                <Border x:Name="ImageContextMenuSheet"
                        Margin="12,0,12,16"
                        Padding="14,14,14,10"
                        VerticalOptions="End"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource BgCard}"
                        TranslationY="30"
                        Opacity="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImageContextMenuSheetTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="2,0,2,8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Card Options"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="ImageContextMenuTitleLabel"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label x:Name="ImageContextMenuUrlLabel"
                                       FontSize="10"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="MiddleTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImageContextMenuCloseTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Copy novel title -->
                        <Border x:Name="ImageContextMenuCopyTitleBtn"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE14D;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource AccentLight}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy novel title"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageContextMenuCopyTitleTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Copy link address -->
                        <Border x:Name="ImageContextMenuCopyNovelUrlBtn"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE157;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource AccentLight}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy link address"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageContextMenuCopyNovelUrlTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Open image in new tab -->
                        <Border x:Name="ImageContextMenuOpenNewTabBtn"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE89E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Open image in new tab"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageContextMenuOpenNewTabTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Copy image -->
                        <Border x:Name="ImageContextMenuCopyImageBtn"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE3F4;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy image"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageContextMenuCopyImageTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Copy image URL -->
                        <Border x:Name="ImageContextMenuCopyUrlBtn"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE14D;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Copy image URL"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImageContextMenuCopyUrlTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border x:Name="ImageActionToast"
                    BackgroundColor="{DynamicResource Accent}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="18,12"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,32"
                    IsVisible="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="&#xE86C;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                    <Label x:Name="ImageActionToastLabel"
                           Text=""
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>

    <!-- ── Novel detail bottom sheet ─────────────────────────────────── -->
    <Grid x:Name="NovelDetailOverlay"
          IsVisible="False"
          BackgroundColor="#88000000"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnNovelDetailOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border x:Name="NovelDetailSheet"
                Margin="0,0,0,0"
                Padding="0"
                VerticalOptions="End"
                MaximumHeightRequest="450"
                Stroke="{DynamicResource Stroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22,22,0,0"
                BackgroundColor="{DynamicResource BgCard}"
                TranslationY="600"
                Opacity="0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNovelDetailSheetTapped" />
            </Border.GestureRecognizers>

            <ScrollView VerticalOptions="End">
                <VerticalStackLayout Spacing="0" VerticalOptions="End">

                    <!-- Drag handle -->
                    <BoxView HeightRequest="4" WidthRequest="36"
                             CornerRadius="2"
                             HorizontalOptions="Center"
                             Margin="0,8,0,0"
                             Color="{DynamicResource Stroke}" />

                    <!-- Cover + basic info row -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="12"
                          Padding="16,12,16,0">

                        <!-- Cover image -->
                        <Border Grid.Column="0"
                                x:Name="DetailCoverBorder"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="68"
                                HeightRequest="96"
                                VerticalOptions="Start">
                            <Border.BackgroundColor>
                                <DynamicResource Key="BgInput" />
                            </Border.BackgroundColor>
                            <!-- Real cover (visible when URL exists) -->
                            <Image x:Name="DetailCoverImage"
                                   Aspect="AspectFill"
                                   WidthRequest="68"
                                   HeightRequest="96" />
                        </Border>

                        <!-- Lily fallback (visible when no cover URL) -->
                        <Border Grid.Column="0"
                                x:Name="DetailCoverFallback"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="68"
                                HeightRequest="96"
                                VerticalOptions="Start"
                                IsVisible="False"
                                BackgroundColor="{DynamicResource AccentContainer}">
                            <Image Source="lily.png"
                                   Aspect="AspectFit"
                                   WidthRequest="28"
                                   HeightRequest="28"
                                   Opacity="0.45"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Title / Author / Chapter info -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label x:Name="DetailTitleLabel"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap"
                                   MaxLines="3"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="DetailTitleEnLabel"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   IsVisible="False"
                                   TextColor="{DynamicResource AccentLight}" />
                            <Label x:Name="DetailAuthorLabel"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label x:Name="DetailAuthorEnLabel"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   IsVisible="False"
                                   TextColor="{DynamicResource AccentLight}" />
                            <Label x:Name="DetailChapterLabel"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>

                        <!-- Action menu button in header -->
                        <Border Grid.Column="2"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                VerticalOptions="Start"
                                Padding="4">
                            <Label Text="&#xE5D4;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDetailMenuTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Close button -->
                        <Border Grid.Column="3"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                VerticalOptions="Start"
                                Padding="4">
                            <Label Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNovelDetailCloseTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <!-- Translate button -->
                    <Border x:Name="TranslateBtn"
                            Margin="16,10,16,0"
                            Padding="12,8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource Stroke}"
                            BackgroundColor="{DynamicResource BgInput}"
                            HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="TranslateBtnIcon"
                                   Text="&#xE8E2;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource AccentLight}" />
                            <Label x:Name="TranslateBtnLabel"
                                   Text="Translate"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <ActivityIndicator x:Name="TranslateSpinner"
                                               IsRunning="False"
                                               IsVisible="False"
                                               Color="{DynamicResource AccentLight}"
                                               WidthRequest="14"
                                               HeightRequest="14"
                                               VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTranslateTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Separator -->
                    <BoxView HeightRequest="1"
                             Margin="16,10,16,0"
                             Color="{DynamicResource Stroke}" />

                    <!-- Summary -->
                    <VerticalStackLayout Padding="16,10,16,0" Spacing="4">
                        <Label Text="Summary"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextSecondary}" />
                        <Label x:Name="DetailSummaryLabel"
                               FontSize="12"
                               MaxLines="5"
                               LineBreakMode="TailTruncation"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label x:Name="DetailSummaryEnLabel"
                               FontSize="12"
                               MaxLines="5"
                               LineBreakMode="TailTruncation"
                               IsVisible="False"
                               TextColor="{DynamicResource AccentLight}" />
                        <Label x:Name="DetailNoSummaryLabel"
                               Text="No summary available."
                               FontSize="12"
                               IsVisible="False"
                               TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>

                    <!-- Action buttons panel -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          Padding="16,12,16,24">
                        <!-- Open in browser -->
                        <Border Grid.Column="0"
                                x:Name="DetailOpenWebBtn"
                                Padding="12,10"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource Stroke}"
                                BackgroundColor="{DynamicResource BgInput}">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center">
                                <Label Text="&#xE157;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMuted}" />
                                <Label Text="Browse"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextPrimary}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDetailOpenWebTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Download -->
                        <Border Grid.Column="1"
                                x:Name="DetailDownloadBtn"
                                Padding="12,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource Accent}">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center">
                                <Label Text="&#xF090;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextOnAccent}" />
                                <Label Text="Download"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource TextOnAccent}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDetailDownloadTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

    </Grid><!-- end root overlay grid -->
</ContentPage>
