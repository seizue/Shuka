<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Shuka.Android.Controls"
             x:Class="Shuka.Android.Pages.SettingsPage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" Opacity="0">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="20,52,20,16"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="110">
            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource AccentContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center"
                    Margin="0,0,14,0">
                <Label Text="{DynamicResource IconSettings}"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource AccentLight}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Settings"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label Text="Customize your experience"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" x:Name="BodyScrollView">
            <VerticalStackLayout Padding="14,20,16,92" Spacing="6">

                <!-- ── APPEARANCE ──────────────────────────── -->
                <Label Text="APPEARANCE"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,0,0,6" />

                <!-- Dark Themes label -->
                <Label Text="Dark"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextMuted}"
                       Margin="4,4,0,4" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Obsidian -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#2E1F1F"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconDarkMode}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Obsidian"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Warm charcoal · modern dark"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioObsidian"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeObsidian" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Rosewood -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#3D2422"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconPalette}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#C4AEA9"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Rosewood"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Warm brown-dark · harmonious"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioRosewood"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeRosewood" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Slate -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#1A1D27"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconContrast}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#9FA8C0"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Slate"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Cool blue-grey · high contrast"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioSlate"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOn}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource Accent}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeSlate" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Amoled -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#000000"
                                    StrokeThickness="1"
                                    Stroke="#1C1C1C"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE51C;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#8B5E5F"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Amoled"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="True black · OLED battery saver"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioAmoled"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeAmoled" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Light Themes label -->
                <Label Text="Light"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextMuted}"
                       Margin="4,12,0,4" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Frost -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F2E8E8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconLightMode}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#7A4E4F"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Frost"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Clean white · modern light"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioParchment"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeParchment" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Parchment -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FBF4E2"
                                    StrokeThickness="1"
                                    Stroke="#E8D9B8"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconBook}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#7A4E4F"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Parchment"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Warm cream · aged paper feel"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioParchment2"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeParchment2" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Blossom -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FEF2F6"
                                    StrokeThickness="1"
                                    Stroke="#F5C6D8"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE8F4;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="#7A4E4F"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Blossom"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Soft pink · delicate light theme"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label x:Name="RadioBlossom"
                                   Grid.Column="2"
                                   Text="{DynamicResource IconRadioOff}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeBlossom" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── DOWNLOADS ──────────────────────────── -->
                <Label Text="DOWNLOADS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,16,0,6" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Current path display -->
                        <Grid ColumnDefinitions="Auto,*" Padding="16,16,16,12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Start"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconFolder}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Download Location"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="DownloadPathLabel"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Change button -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE2C8;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Change Folder"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Pick a custom save location"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangeDownloadFolderTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Reset to default -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE042;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Reset to Default"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Downloads/Shuka"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResetDownloadFolderTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── BROWSER ─────────────────────────────── -->
                <Label Text="BROWSER"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,16,0,6" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Ad Blocker Toggle -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE14B;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Ad Blocker"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Block ads and trackers in WebView"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Switch x:Name="AdBlockerSwitch"
                                    Grid.Column="2"
                                    IsToggled="True"
                                    OnColor="{DynamicResource AccentLight}"
                                    ThumbColor="White"
                                    VerticalOptions="Center"
                                    Toggled="OnAdBlockerToggled" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── BOOKMARKS ───────────────────────────── -->
                <Label Text="BOOKMARKS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,16,0,6" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Backup Bookmarks -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE2C4;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Backup Bookmarks"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Export all bookmarks to a JSON file"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackupBookmarksTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Restore Bookmarks -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE2C6;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Restore Bookmarks"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Import bookmarks from a JSON backup file"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRestoreBookmarksTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── UPDATE ─────────────────────────────── -->

                <Label Text="UPDATE"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,16,0,6" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Current version + update status -->
                        <Grid ColumnDefinitions="Auto,*" Padding="16,16,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Start"
                                    Margin="0,0,14,0">
                                <Label Text="&#xE923;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label x:Name="UpdateVersionLabel"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="UpdateStatusLabel"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- Check / Install button -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14,16,14">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label x:Name="UpdateActionIcon"
                                       Text="&#xE923;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="UpdateActionLabel"
                                       Text="Check for Updates"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="UpdateActionSub"
                                       Text="Tap to check GitHub releases"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <!-- Progress bar (visible during download) -->
                            <VerticalStackLayout Grid.Column="2"
                                                 x:Name="UpdateProgressStack"
                                                 IsVisible="False"
                                                 WidthRequest="60"
                                                 VerticalOptions="Center">
                                <Label x:Name="UpdateProgressLabel"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center" />
                                <ProgressBar x:Name="UpdateProgressBar"
                                             Progress="0"
                                             ProgressColor="{DynamicResource AccentLight}"
                                             HeightRequest="4" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   x:Name="UpdateChevron"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUpdateTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ── SUPPORT ─────────────────────────────── -->
                <Label Text="SUPPORT"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentLight}"
                       CharacterSpacing="1.5"
                       Margin="4,16,0,6" />

                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout>

                        <!-- Bug Report -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconBug}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource Danger}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Report a Bug"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Open a GitHub issue"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBugReportTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Divider}" Margin="16,0" />

                        <!-- About -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,16,16,16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center"
                                    Margin="0,0,14,0">
                                <Label Text="{DynamicResource IconInfo}"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="About Shuka"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="Version, licenses &amp; credits"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{DynamicResource IconChevronRight}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Version -->
                <Label x:Name="FooterVersionLabel"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Duplicate Resolution Sheet (Restore Bookmarks) ───────────────── -->
        <Grid x:Name="DuplicateSheetOverlay"
              IsVisible="False"
              BackgroundColor="#88000000"
              Grid.RowSpan="2">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDuplicateSheetOverlayTapped" />
            </Grid.GestureRecognizers>

            <Border x:Name="DuplicateSheet"
                    Margin="12,0,12,16"
                    Padding="14,14,14,12"
                    VerticalOptions="End"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource BgCard}"
                    TranslationY="28"
                    Opacity="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDuplicateSheetTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="12">

                    <!-- Header: icon · title · subtitle · close -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                BackgroundColor="{DynamicResource AccentContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="36" HeightRequest="36"
                                VerticalOptions="Center">
                            <Label Text="&#xE2C6;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="18"
                                   TextColor="{DynamicResource AccentLight}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Duplicate Found"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="DuplicateSheetTitle"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xE5CD;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="20"
                               TextColor="{DynamicResource TextMuted}"
                               VerticalOptions="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDuplicateSheetCloseTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Chapter count comparison -->
                    <Border BackgroundColor="{DynamicResource BgInput}"
                            Stroke="{DynamicResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto,*">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                                <Label Text="CURRENT"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="DuplicateSheetCurrentChapters"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalOptions="Center" />
                                <Label Text="chapters"
                                       FontSize="9"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE315;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Margin="8,0" />
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="1">
                                <Label Text="BACKUP"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center" />
                                <Label x:Name="DuplicateSheetBackupChapters"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center" />
                                <Label Text="chapters"
                                       FontSize="9"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Action rows -->
                    <VerticalStackLayout Spacing="8">

                        <!-- Keep Existing -->
                        <Border BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE876;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Keep Existing"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Text="Leave the current bookmark unchanged"
                                           FontSize="10"
                                           TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDuplicateKeepTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Replace with Backup -->
                        <Border BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE042;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource AccentLight}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Replace with Backup"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Text="Overwrite this bookmark with the backup version"
                                           FontSize="10"
                                           TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDuplicateReplaceTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Replace All with Backup -->
                        <Border BackgroundColor="{DynamicResource AccentContainer}"
                                Stroke="{DynamicResource AccentLight}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE2C6;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource AccentLight}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Replace All with Backup"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource AccentLight}" />
                                    <Label Text="Overwrite all remaining duplicates with backup"
                                           FontSize="10"
                                           TextColor="{DynamicResource AccentLight}"
                                           Opacity="0.75" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDuplicateReplaceAllTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Skip All Remaining -->
                        <Border BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xEAD0;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Skip All Remaining"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Text="Keep all existing bookmarks unchanged"
                                           FontSize="10"
                                           TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDuplicateSkipAllTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
