<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Shuka.Android.Controls"
             x:Class="Shuka.Android.Pages.MainPage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*" Opacity="0">

        <!-- ── Top App Bar ──────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="20,52,20,16"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="110">

            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource AccentContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center"
                    Margin="0,0,14,0">
                <Image Source="lily.png"
                       WidthRequest="38" HeightRequest="38"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Shuka"
                       FontSize="28"
                       TextColor="{DynamicResource TextMuted}" 
                       FontFamily="Pacifico" />
            </VerticalStackLayout>
        </Grid>



        <!-- ── Tab bar: Download | Discover ─────────────────── -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="48">

            <!-- Download tab -->
            <Grid Grid.Column="0" x:Name="TabDownloadPill">
                <Label x:Name="TabDownloadLabel"
                       Text="DOWNLOAD"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <!-- Active indicator bar -->
                <BoxView x:Name="TabDownloadBar"
                         HeightRequest="2"
                         VerticalOptions="End"
                         HorizontalOptions="Fill"
                         Margin="20,0" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabDownloadTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Discover tab -->
            <Grid Grid.Column="1" x:Name="TabDiscoverPill">
                <Label x:Name="TabDiscoverLabel"
                       Text="DISCOVER"
                       FontSize="13" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <!-- Active indicator bar -->
                <BoxView x:Name="TabDiscoverBar"
                         HeightRequest="2"
                         VerticalOptions="End"
                         HorizontalOptions="Fill"
                         Margin="20,0" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabDiscoverTapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>



        <!-- ── Body ─────────────────────────────────────────── -->
        <Grid Grid.Row="2" x:Name="BodyGrid">

            <!-- ══ DOWNLOAD PANEL ══════════════════════════════ -->
            <ScrollView x:Name="DownloadPanel">
                <VerticalStackLayout x:Name="BodyScrollView" Padding="16,12,16,112" Spacing="14">

                    <!-- ── Input card ──────────────────────────── -->
                    <Border BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="20,16,20,20">
                        <VerticalStackLayout Spacing="18">

                            <!-- Novel URL -->
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{DynamicResource IconLink}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="14"
                                           TextColor="{DynamicResource AccentLight}"
                                           VerticalOptions="Center" />
                                    <Label Text="Novel URL"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Stroke="{DynamicResource Stroke}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource BgInput}"
                                        Padding="14,0,4,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <Entry Grid.Column="0"
                                               x:Name="UrlEntry"
                                               Placeholder="https://czbooks.net/n/... or quanben.io/n/..."
                                               Keyboard="Url"
                                               ReturnType="Next"
                                               HeightRequest="48" />
                                        <Border Grid.Column="1"
                                                x:Name="UrlPreviewBtn"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="6,0"
                                                VerticalOptions="Center">
                                            <Label Text="&#xE8F4;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="18"
                                                   TextColor="{DynamicResource AccentLight}"
                                                   VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUrlPreviewTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <Border Grid.Column="2"
                                                x:Name="UrlPasteBtn"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="6,0"
                                                VerticalOptions="Center">
                                            <Label Text="&#xE22B;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="18"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUrlPasteTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <Border Grid.Column="3"
                                                x:Name="UrlClearBtn"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="6,0,8,0"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                            <Label Text="&#xE5CD;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="18"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUrlClearTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Preview Info Card -->
                            <Border x:Name="PreviewInfoCard"
                                    BackgroundColor="{DynamicResource AccentContainer}"
                                    Stroke="{DynamicResource AccentLight}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14,12"
                                    IsVisible="False">
                                <VerticalStackLayout Spacing="6">
                                    <Label x:Name="PreviewTitle"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           LineBreakMode="WordWrap" />
                                    <Label x:Name="PreviewAuthor"
                                           FontSize="12"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Label x:Name="PreviewChapters"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource AccentLight}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Cover URL -->
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{DynamicResource IconImage}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="14"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Text="Cover URL"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="· optional"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Stroke="{DynamicResource Stroke}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource BgInput}"
                                        Padding="14,0,4,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Entry Grid.Column="0"
                                               x:Name="CoverEntry"
                                               Placeholder="https://..."
                                               Keyboard="Url"
                                               ReturnType="Next"
                                               HeightRequest="48" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="6,0"
                                                VerticalOptions="Center">
                                            <Label Text="&#xE22B;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="18"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCoverPasteTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <Border Grid.Column="2"
                                                x:Name="CoverClearBtn"
                                                BackgroundColor="Transparent"
                                                StrokeThickness="0"
                                                Padding="6,0,8,0"
                                                VerticalOptions="Center"
                                                IsVisible="False">
                                            <Label Text="&#xE5CD;"
                                                   FontFamily="{DynamicResource IconFont}"
                                                   FontSize="18"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCoverClearTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Chapters -->
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{DynamicResource IconNumbers}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="14"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Text="Chapters"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                                    <Label Text="· 0 = all  ·  e.g. 100-200"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Stroke="{DynamicResource Stroke}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource BgInput}"
                                        Padding="14,0">
                                    <Entry x:Name="ChaptersEntry"
                                           Text="0"
                                           Placeholder="0  or  100-200"
                                           Keyboard="Text"
                                           HeightRequest="48" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Translate behavior -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4,0,0">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{DynamicResource IconTranslate}"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="14"
                                               TextColor="{DynamicResource AccentLight}"
                                               VerticalOptions="Center" />
                                        <Label Text="Translate to English"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label x:Name="TranslateOptionSub"
                                           Text="Translates title, author, and chapters to English using Google Translate"
                                           FontSize="11"
                                           TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                                <Switch x:Name="TranslateSwitch"
                                        Grid.Column="1"
                                        IsToggled="True"
                                        OnColor="{DynamicResource AccentLight}"
                                        ThumbColor="White"
                                        VerticalOptions="Center"
                                        Toggled="OnTranslateToggled" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ── Download button ─────────────────────── -->
                    <Border x:Name="DownloadBtn"
                            BackgroundColor="{DynamicResource Accent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            HeightRequest="58"
                            Padding="0">
                        <Grid ColumnDefinitions="Auto,*" Padding="22,0">
                            <Label Grid.Column="0"
                                   Text="{DynamicResource IconDownload}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextOnAccent}"
                                   VerticalOptions="Center"
                                   Margin="0,0,14,0" />
                            <Label Grid.Column="1"
                                   x:Name="DownloadBtnLabel"
                                   Text="Download &amp; Translate"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextOnAccent}"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDownloadClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- ── Queued confirmation banner ──────────── -->
                    <Border x:Name="QueuedBanner"
                            BackgroundColor="{DynamicResource AccentContainer}"
                            Stroke="{DynamicResource AccentLight}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,14"
                            IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="{DynamicResource IconDownload}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource AccentLight}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Download queued!"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}" />
                                <Label Text="Check the Downloads tab to track progress."
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ── Tip card ────────────────────────────── -->
                    <Border BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource Stroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="{DynamicResource IconInfo}"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="18"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Start"
                                   Margin="0,1,0,0" />
                            <Label Grid.Column="1"
                                   Text="You can queue multiple novels at once. Each download runs independently — switch to the Downloads tab to monitor progress or cancel."
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ══ DISCOVER PANEL ════════════════════════════ -->
            <Grid x:Name="DiscoverPanel" IsVisible="False" RowDefinitions="Auto,*">

                <!-- Global search bar -->
                <Border Grid.Row="0"
                        BackgroundColor="{DynamicResource BgPage}"
                        StrokeThickness="0"
                        Padding="16,12,16,8">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <!-- Search textbox -->
                            <Border Grid.Column="0"
                                    Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           x:Name="GlobalSearchEntry"
                                           Placeholder="Search all sources..."
                                           Keyboard="Text"
                                           HeightRequest="44"
                                           ReturnType="Search"
                                           Completed="OnGlobalSearchCompleted" />
                                    <Label Grid.Column="1"
                                           x:Name="GlobalSearchClearBtn"
                                           Text="&#xE5CD;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center"
                                           IsVisible="False">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnGlobalSearchClearTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                            <!-- Browser icon — separate container, opens Shuka Quest Mini Browser -->
                            <Border Grid.Column="1"
                                    x:Name="BrowserIconBtn"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource Accent}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    VerticalOptions="Center">
                                <Label Text="&#xE80B;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="20"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBrowserIconTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <!-- Scope Filter Chips -->
                        <HorizontalStackLayout Spacing="8">
                            <!-- Global Chip -->
                            <Border x:Name="ChipGlobal"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,6"
                                    BackgroundColor="{DynamicResource BgInput}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipGlobalTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xE894;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalOptions="Center"/>
                                    <Label Text="Global" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Selected Source Chip -->
                            <Border x:Name="ChipSelected"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,6"
                                    BackgroundColor="{DynamicResource BgInput}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipSelectedTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xE8B0;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalOptions="Center"/>
                                    <Label x:Name="ChipSelectedLabel" Text="Selected: ..." FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="&#xE5C5;" FontFamily="{DynamicResource IconFont}" FontSize="11" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Pinned Chip -->
                            <Border x:Name="ChipPinned"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,6"
                                    BackgroundColor="{DynamicResource BgInput}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipPinnedTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="&#xE9C9;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalOptions="Center"/>
                                    <Label Text="Pinned Only" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Source list -->
                <ScrollView Grid.Row="1" x:Name="DiscoverSourceScrollView">
                    <VerticalStackLayout Padding="16,12,16,40" Spacing="8"
                                         x:Name="DiscoverSourceList" />
                </ScrollView>

                <!-- Global search results -->
                <Grid Grid.Row="1" x:Name="SearchResultsView" IsVisible="False" RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           x:Name="SearchResultsLabel"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           Margin="20,12,20,4" />
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="16,4,16,40" Spacing="8"
                                             x:Name="SearchResultsList" />
                    </ScrollView>
                </Grid>

                <!-- Loading/Progress state for global search -->
                <ScrollView Grid.Row="1" x:Name="SearchProgressScrollView" IsVisible="False">
                    <VerticalStackLayout Padding="20,16,20,40" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Label Grid.Column="0"
                                   x:Name="SearchProgressHeader"
                                   Text="Searching sources..."
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1"
                                               x:Name="SearchProgressSpinner"
                                               IsRunning="True"
                                               Color="{DynamicResource AccentLight}"
                                               WidthRequest="24" HeightRequest="24"
                                               VerticalOptions="Center" />
                        </Grid>
                        
                        <VerticalStackLayout x:Name="SearchProgressList" Spacing="12" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Bookmark toast banner for Discover -->
                <Border Grid.Row="1"
                        x:Name="DiscoverBookmarkBanner"
                        IsVisible="False"
                        Opacity="0"
                        Margin="16,0,16,10"
                        VerticalOptions="End"
                        BackgroundColor="{DynamicResource AccentContainer}"
                        Stroke="{DynamicResource AccentLight}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="&#xE866;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="16"
                               TextColor="{DynamicResource AccentLight}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               x:Name="DiscoverBookmarkBannerLabel"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AccentLight}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- Custom Source Selection Modal Overlay -->
        <Grid x:Name="SourceSelectModal"
              Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="False"
              Opacity="0">
            
            <!-- Background Dimmer (handles click to close) -->
            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSourceSelectModalBackgroundTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            
            <!-- Bottom Sheet -->
            <Border x:Name="SourceSelectBottomSheet"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    Padding="20,24,20,32"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    BackgroundColor="{DynamicResource BgPage}"
                    Stroke="{DynamicResource Stroke}"
                    TranslationY="400">
                <VerticalStackLayout Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Select Search Source"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseSourceSelectModalTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    
                    <!-- Scrollable source options -->
                    <ScrollView MaximumHeightRequest="400">
                        <VerticalStackLayout x:Name="SourceSelectOptionsContainer" Spacing="10" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
