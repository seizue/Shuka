<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Shuka.Android.Controls"
             x:Class="Shuka.Android.Pages.HistoryPage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*" Opacity="0">

        <!-- ── Top App Bar ──────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="20,52,20,16"
              BackgroundColor="{DynamicResource BgCard}"
              HeightRequest="110">

            <Border Grid.Column="0"
                    BackgroundColor="{DynamicResource AccentContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center"
                    Margin="0,0,14,0">
                <Label Text="&#xE889;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource AccentLight}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="History"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />
                <Label x:Name="CountLabel"
                       Text="Your downloaded novels"
                       FontSize="12"
                       TextColor="{DynamicResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Clear All -->
            <Border Grid.Column="2"
                    x:Name="ClearAllBtn"
                    BackgroundColor="{DynamicResource BgInput}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,8"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="&#xE872;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                    <Label Text="Clear"
                           FontSize="12" FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearAllTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ── Search bar ────────────────────────────────────── -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource BgCard}"
                StrokeThickness="0"
                Padding="16,10,16,0">
            <Border Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{DynamicResource BgInput}"
                    Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="&#xE8B6;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="18"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"
                           Margin="0,0,8,0" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search by title or author..."
                           Keyboard="Text"
                           HeightRequest="44"
                           TextChanged="OnSearchTextChanged" />
                    <Label Grid.Column="2"
                           x:Name="ClearSearchBtn"
                           Text="&#xE5CD;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="18"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"
                           IsVisible="False">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearchTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </Border>

        <!-- ── Sort pills ─────────────────────────────────────── -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource BgCard}"
                StrokeThickness="0"
                Padding="16,10,16,14">
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <!-- Date pill -->
                    <Border x:Name="SortDatePill"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="12,6">
                        <HorizontalStackLayout Spacing="5">
                            <Label x:Name="SortDateIcon"
                                   Text="&#xE8B6;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortDateLabel"
                                   Text="Date"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortDateArrow"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   IsVisible="False" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSortDateTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Title pill -->
                    <Border x:Name="SortTitlePill"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="12,6">
                        <HorizontalStackLayout Spacing="5">
                            <Label x:Name="SortTitleIcon"
                                   Text="&#xE264;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortTitleLabel"
                                   Text="Title"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortTitleArrow"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   IsVisible="False" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSortTitleTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Author pill -->
                    <Border x:Name="SortAuthorPill"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="12,6">
                        <HorizontalStackLayout Spacing="5">
                            <Label x:Name="SortAuthorIcon"
                                   Text="&#xE7FD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortAuthorLabel"
                                   Text="Author"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label x:Name="SortAuthorArrow"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   IsVisible="False" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSortAuthorTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- View Mode Toggle Pill -->
                <Border Grid.Column="1"
                        x:Name="ToggleViewPill"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,6"
                        HorizontalOptions="End">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="ToggleViewIcon"
                               Text="&#xE8EF;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Label x:Name="ToggleViewLabel"
                               Text="List"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleViewTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- ── Body ─────────────────────────────────────────── -->
        <Grid Grid.Row="3" x:Name="BodyGrid">

            <!-- Loading Skeleton -->
            <controls:HistoryLoadingSkeleton x:Name="LoadingSkeletonView" 
                                            IsVisible="False" />

            <!-- Empty state (no novels at all) -->
            <VerticalStackLayout x:Name="EmptyState"
                                 Spacing="14"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Border BackgroundColor="{DynamicResource BgCard}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 32"
                        WidthRequest="80" HeightRequest="80"
                        HorizontalOptions="Center">
                    <Label Text="&#xE889;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="40"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="No novels yet"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalOptions="Center" />
                <Label Text="Completed downloads will appear here"
                       FontSize="13"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- No search results state -->
            <VerticalStackLayout x:Name="NoResultsState"
                                 Spacing="14"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="False">
                <Border BackgroundColor="{DynamicResource BgCard}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 32"
                        WidthRequest="80" HeightRequest="80"
                        HorizontalOptions="Center">
                    <Label Text="&#xE8B6;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="40"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label x:Name="NoResultsLabel"
                       Text="No results found"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalOptions="Center" />
                <Label Text="Try a different search term"
                       FontSize="13"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Scrollable list of novel cards -->
            <ScrollView x:Name="ListScroll" IsVisible="False">
                <VerticalStackLayout x:Name="CardList"
                                     Padding="12,12,12,92"
                                     Spacing="8" />
            </ScrollView>

            <!-- Scrollable grid of novel cards -->
            <ScrollView x:Name="GridScroll" IsVisible="False">
                <Grid x:Name="CardGrid"
                      ColumnDefinitions="*,*,*,*"
                      RowSpacing="8"
                      ColumnSpacing="8"
                      Padding="12,14,12,92" />
            </ScrollView>

        </Grid>

        <!-- Options bottom sheet overlay -->
        <Grid x:Name="OptionsSheetOverlay"
              IsVisible="False"
              BackgroundColor="#88000000"
              Grid.RowSpan="4">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOptionsSheetOverlayTapped" />
            </Grid.GestureRecognizers>

            <Border x:Name="OptionsSheet"
                    Margin="12,0,12,16"
                    Padding="14,14,14,10"
                    VerticalOptions="End"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource BgCard}"
                    TranslationY="28"
                    Opacity="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOptionsSheetTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="12">
                    <!-- Title & Subtitle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Options"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label x:Name="OptionsSheetSubtitle"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{DynamicResource TextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="&#xE5CD;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="20"
                               TextColor="{DynamicResource TextMuted}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetCloseTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Option Buttons -->
                    <VerticalStackLayout Spacing="8">
                        <!-- Share Option -->
                        <Border x:Name="OptionsSheetShareBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE6B8;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Share EPUB"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetShareTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Re-download Option -->
                        <Border x:Name="OptionsSheetRedownloadBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xF090;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Re-download Novel"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetRedownloadTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Remove Option -->
                        <Border x:Name="OptionsSheetRemoveBtn"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="&#xE872;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource Warning}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Remove from History"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Warning}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOptionsSheetRemoveTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
