<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shuka.Android.Pages.WebBrowsePage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Top bar ───────────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="44,44,*,44,44,44"
              HeightRequest="96"
              Padding="8,44,8,8"
              BackgroundColor="{DynamicResource BgCard}">

            <!-- Back button -->
            <Grid Grid.Column="0"
                  x:Name="BackButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE5C4;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="22"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Forward button -->
            <Grid Grid.Column="1"
                  x:Name="ForwardButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Opacity="0.4">
                <Label Text="&#xE5C8;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="22"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForwardTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- URL pill with loading indicator -->
            <Border Grid.Column="2"
                    x:Name="UrlBarBorder"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource BgInput}"
                    HeightRequest="34"
                    Padding="10,0"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="UrlBarLabel"
                           Grid.Column="0"
                           FontSize="11"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                    <!-- URL bar loading indicator - shows immediately during navigation -->
                    <ActivityIndicator x:Name="UrlLoadingIndicator"
                                     Grid.Column="1"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="{DynamicResource AccentLight}"
                                     WidthRequest="14"
                                     HeightRequest="14"
                                     VerticalOptions="Center"
                                     Margin="4,0,0,0" />
                </Grid>
            </Border>

            <!-- Tabs -->
            <Grid Grid.Column="3"
                  x:Name="TabsButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Grid>
                    <Label Text="&#xE8D2;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="20"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border BackgroundColor="{DynamicResource Accent}"
                            StrokeThickness="0"
                            WidthRequest="16"
                            HeightRequest="16"
                            StrokeShape="RoundRectangle 8"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,2,2,0">
                        <Label x:Name="TabCountLabel"
                               Text="1"
                               FontSize="9"
                               TextColor="{DynamicResource TextOnAccent}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabsTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Reload button -->
            <Grid Grid.Column="4"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE5D5;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReloadTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- More menu -->
            <Grid Grid.Column="5"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE5D4;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMoreTapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- ── WebView + FAB overlay ─────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- WebView -->
            <WebView x:Name="SiteWebView"
                     Navigating="OnNavigating"
                     Navigated="OnNavigated" />

            <!-- Loading bar -->
            <ProgressBar x:Name="LoadingBar"
                         Progress="0"
                         ProgressColor="{DynamicResource AccentLight}"
                         VerticalOptions="Start"
                         HeightRequest="3"
                         IsVisible="False" />

            <!-- Initial loading overlay - shown immediately when page opens -->
            <Grid x:Name="InitialLoadingOverlay"
                  IsVisible="True"
                  BackgroundColor="{DynamicResource BgPage}">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="16">
                    <ActivityIndicator x:Name="InitialLoadingSpinner"
                                       IsRunning="True"
                                       Color="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       WidthRequest="48"
                                       HeightRequest="48" />
                    <Label Text="Loading page..."
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Full-page spinner while escaping Google Translate (no about:blank dead time) -->
            <Grid x:Name="LeaveOriginalOverlay"
                  IsVisible="False"
                  BackgroundColor="#99101010">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12"
                                     Margin="32">
                    <ActivityIndicator x:Name="LeaveOriginalSpinner"
                                       IsRunning="True"
                                       Color="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Opening original page…"
                           TextColor="{DynamicResource TextPrimary}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LeaveOriginalSubtitle"
                           FontSize="10"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           MaxLines="3"
                           LineBreakMode="MiddleTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- FABs — bottom-right corner, collapsible menu -->
            <VerticalStackLayout x:Name="FabContainer"
                                 HorizontalOptions="End"
                                 VerticalOptions="End"
                                 Spacing="10"
                                 Margin="0,0,16,28">

                <!-- Collapsible FAB menu items (hidden by default) -->
                <VerticalStackLayout x:Name="FabMenuItems"
                                     Spacing="10"
                                     HorizontalOptions="End"
                                     IsVisible="False"
                                     Opacity="0">

                    <!-- Row 1: Utility buttons (Bookmark, Translate, Browser) -->
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End">

                        <!-- Bookmark FAB — toggles bookmark state -->
                        <Border x:Name="FabBookmark"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label x:Name="FabBookmarkIcon"
                                       Text="&#xE866;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="FabBookmarkLabel"
                                       Text="BOOKMARK"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBookmarkTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Translate FAB — toggles Google Translate proxy -->
                        <Border x:Name="FabTranslate"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label x:Name="FabTranslateIcon"
                                       Text="&#xE8E2;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="FabTranslateLabel"
                                       Text="TRANSLATE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTranslateTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Browser FAB — always visible -->
                        <Border x:Name="FabBrowser"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xE89E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Text="BROWSER"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenInBrowserTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>

                    <!-- Row 2: Action buttons (Fetch, Download) -->
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End">

                        <!-- Fetch FAB — shown on novel pages, pre-fills Download tab URL -->
                        <Border x:Name="FabFetch"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xE2C4;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                                <Label Text="FETCH"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFetchFabTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Download FAB — shown only on supported novel pages -->
                        <Border x:Name="FabDownload"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="16,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xF090;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                                <Label Text="DOWNLOAD"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDownloadFabTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <!-- Toggle FAB — always visible, expands/collapses menu -->
                <Border x:Name="FabToggle"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="End">
                    <Label x:Name="FabToggleIcon"
                           Text="&#xE5CE;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="24"
                           TextColor="{DynamicResource TextOnAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Rotation="0" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFabToggleTapped" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>

            <!-- Queued toast — bottom-center -->
            <Border x:Name="QueuedToast"
                    BackgroundColor="{DynamicResource Accent}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="18,12"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,90"
                    IsVisible="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="&#xE86C;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                    <Label x:Name="QueuedToastLabel"
                           Text="Queued!"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Invalid URL banner — bottom-center, warning style -->
            <Border x:Name="InvalidUrlBanner"
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="16,0,16,90"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="&#xE002;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="22"
                           TextColor="{DynamicResource Warning}"
                           VerticalOptions="Start"
                           Margin="0,1,0,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Not a downloadable novel page"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label x:Name="InvalidUrlHintLabel"
                               FontSize="11"
                               TextColor="{DynamicResource TextMuted}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Book info panel — slides up when a novel page is detected -->
            <!-- Shows original Chinese title/author + English translation -->
            <Border x:Name="BookInfoPanel"
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18,18,0,0"
                    Padding="16,14,16,20"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    TranslationY="120"
                    Opacity="0"
                    IsVisible="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <!-- Text info -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">

                        <!-- Original title (Chinese) -->
                        <Label x:Name="BookInfoOriginalTitle"
                               FontSize="14"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               TextColor="{DynamicResource TextPrimary}" />

                        <!-- Translated title (English) -->
                        <Label x:Name="BookInfoTranslatedTitle"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               IsVisible="False"
                               TextColor="{DynamicResource AccentLight}" />

                        <!-- Author row: original + translated -->
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="BookInfoAuthor"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label x:Name="BookInfoAuthorTranslated"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   IsVisible="False"
                                   TextColor="{DynamicResource TextMuted}" />
                        </HorizontalStackLayout>

                        <!-- Loading indicator while fetching -->
                        <HorizontalStackLayout x:Name="BookInfoLoading" Spacing="6" IsVisible="True">
                            <ActivityIndicator IsRunning="True"
                                               Color="{DynamicResource AccentLight}"
                                               WidthRequest="12"
                                               HeightRequest="12"
                                               VerticalOptions="Center" />
                            <Label Text="Fetching info…"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <!-- Close button -->
                    <Grid Grid.Column="1"
                          WidthRequest="32"
                          HeightRequest="32"
                          VerticalOptions="Start">
                        <Label Text="&#xE5CD;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="18"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBookInfoPanelCloseTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </Border>

            <!-- Tab overview panel -->
            <Grid x:Name="TabOverviewOverlay"
                  IsVisible="False"
                  BackgroundColor="#AA101010"
                  Padding="16,24,16,24">
                <Border BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">
                    <Grid RowDefinitions="Auto,Auto,*,Auto"
                          RowSpacing="12">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tabs"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="TabOverviewCountLabel"
                                       Text="1 tab"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="22"
                                   TextColor="{DynamicResource TextMuted}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTabOverviewDoneTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <HorizontalStackLayout Grid.Row="1"
                                               Spacing="8">
                            <Border BackgroundColor="{DynamicResource AccentContainer}"
                                    Stroke="{DynamicResource AccentLight}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,8">
                                <Label Text="+ New Tab"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AccentLight}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabOverviewNewTabTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>

                            <Border BackgroundColor="{DynamicResource BgInput}"
                                    Stroke="{DynamicResource Stroke}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,8">
                                <Label Text="Close Others"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabOverviewCloseOthersTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>

                            <Border BackgroundColor="{DynamicResource BgInput}"
                                    Stroke="{DynamicResource Stroke}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,8">
                                <Label Text="Recent Links"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabOverviewRecentTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>

                        <ScrollView Grid.Row="2">
                            <VerticalStackLayout x:Name="TabOverviewList"
                                                 Spacing="10" />
                        </ScrollView>

                        <Border Grid.Row="3"
                                BackgroundColor="{DynamicResource BgInput}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                HorizontalOptions="Center">
                            <Label Text="Done"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTabOverviewDoneTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Browser menu bottom sheet -->
            <Grid x:Name="BrowserMenuOverlay"
                  IsVisible="False"
                  BackgroundColor="#88000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBrowserMenuOverlayTapped" />
                </Grid.GestureRecognizers>

                <Border x:Name="BrowserMenuSheet"
                        Margin="12,0,12,16"
                        Padding="14,14,14,10"
                        VerticalOptions="End"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource BgCard}"
                        TranslationY="30"
                        Opacity="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBrowserMenuSheetTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="2,0,2,8">
                            <Label Text="Browser Menu"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBrowserMenuCloseTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Border StyleClass="MenuRow"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE889;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Recent links"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBrowserMenuRecentTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border x:Name="BrowserMenuAdBlockRow"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label x:Name="BrowserMenuAdBlockIcon"
                                       Text="&#xE14B;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="0">
                                    <Label Text="Ad blocker"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label x:Name="BrowserMenuAdBlockSubtitle"
                                           Text="Off"
                                           FontSize="10"
                                           TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       x:Name="BrowserMenuAdBlockState"
                                       Text="OFF"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBrowserMenuAdBlockTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE5D5;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Refresh"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBrowserMenuRefreshTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE88A;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Home"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBrowserMenuHomeTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto"
                                  ColumnSpacing="10">
                                <Label Text="&#xE89E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Open in browser"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBrowserMenuOpenInBrowserTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recent links bottom sheet -->
            <Grid x:Name="RecentLinksOverlay"
                  IsVisible="False"
                  BackgroundColor="#88000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecentLinksOverlayTapped" />
                </Grid.GestureRecognizers>

                <Border x:Name="RecentLinksSheet"
                        Margin="12,0,12,16"
                        Padding="14,14,14,10"
                        VerticalOptions="End"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource BgCard}"
                        TranslationY="30"
                        Opacity="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecentLinksSheetTapped" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="10">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Recent Links"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="RecentLinksCountLabel"
                                       Text="0 links"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentLinksCloseTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <ScrollView Grid.Row="1"
                                    HeightRequest="360">
                            <VerticalStackLayout x:Name="RecentLinksList"
                                                 Spacing="8" />
                        </ScrollView>

                        <HorizontalStackLayout Grid.Row="2"
                                               HorizontalOptions="End"
                                               Spacing="8">
                            <Border BackgroundColor="{DynamicResource BgInput}"
                                    Stroke="{DynamicResource Stroke}"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,8">
                                <Label Text="Clear History"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Warning}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecentLinksClearTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <Border BackgroundColor="{DynamicResource BgInput}"
                                    Stroke="{DynamicResource Stroke}"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,8">
                                <Label Text="Done"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecentLinksCloseTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Cloudflare translate options sheet -->
            <Grid x:Name="CloudflareSheetOverlay"
                  IsVisible="False"
                  BackgroundColor="#88000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloudflareSheetOverlayTapped" />
                </Grid.GestureRecognizers>

                <Border x:Name="CloudflareSheet"
                        Margin="12,0,12,16"
                        Padding="14,14,14,10"
                        VerticalOptions="End"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource BgCard}"
                        TranslationY="30"
                        Opacity="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloudflareSheetTapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Cloudflare Protected Site"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="CloudflareSheetSubtitle"
                                       Text="Translate works better in external browser."
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloudflareSheetCancelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                                <Label Text="&#xE8E2;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                                <Label Grid.Column="1"
                                       Text="Google Translate (browser)"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloudflareTranslateBrowserTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                                <Label Text="&#xE14D;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                                <Label Grid.Column="1"
                                       Text="Copy URL"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloudflareCopyUrlTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource BgInput}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                                <Label Text="&#xE89E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                                <Label Grid.Column="1"
                                       Text="Open page (browser)"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Grid.Column="2"
                                       Text="&#xE5CC;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextMuted}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloudflareOpenBrowserTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Image context menu bottom sheet (WebView long-press — same as Shuka Quest) -->
            <Grid x:Name="ImageContextMenuOverlay"
                  IsVisible="False"
                  BackgroundColor="#88000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImageContextMenuOverlayTapped" />
                </Grid.GestureRecognizers>

                <Border x:Name="ImageContextMenuSheet"
                        Margin="12,0,12,16"
                        Padding="14,14,14,10"
                        VerticalOptions="End"
                        Stroke="{DynamicResource Stroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource BgCard}"
                        TranslationY="30"
                        Opacity="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImageContextMenuSheetTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">

                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="2,0,2,8">
                            <VerticalStackLayout Spacing="2">
                                <Label x:Name="ImageContextMenuTitleLabel"
                                       Text="Image Options"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label x:Name="ImageContextMenuUrlLabel"
                                       FontSize="10"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="MiddleTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5CD;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="20"
                                   TextColor="{DynamicResource TextMuted}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImageContextMenuCloseTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Image Options Section -->
                        <VerticalStackLayout x:Name="ImageOptionsSection" Spacing="6" IsVisible="True">
                            <!-- Open image in new tab -->
                            <Border Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="&#xE157;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Open image in new tab"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImageContextMenuOpenNewTabTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Copy image -->
                            <Border Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="&#xE3F4;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Copy image"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImageContextMenuCopyImageTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Copy image URL -->
                            <Border Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="&#xE14D;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Copy image URL"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnImageContextMenuCopyUrlTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Link Options Section -->
                        <VerticalStackLayout x:Name="LinkOptionsSection" Spacing="6" IsVisible="False">
                            <Label x:Name="LinkSectionHeaderLabel"
                                   Text="Link Options"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMuted}"
                                   Margin="4,4,0,2"
                                   IsVisible="False" />

                            <!-- Open link in new tab -->
                            <Border Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="&#xE157;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Open link in new tab"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLinkContextMenuOpenNewTabTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Copy link -->
                            <Border Stroke="{DynamicResource Stroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgInput}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="&#xE14D;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Copy link"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextPrimary}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="18"
                                           TextColor="{DynamicResource TextMuted}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLinkContextMenuCopyUrlTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
