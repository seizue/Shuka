<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.seizue.shuka">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Storage: legacy API ≤ 28 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />

    <!-- Foreground service to keep downloads alive in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- WAKE_LOCK: required for PowerManager.WakeLock (PARTIAL_WAKE_LOCK) -->
    <!-- Prevents the CPU from deep-sleeping while downloading in the background. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Broad storage access on Android 11+ for custom paths -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Completion notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to install APK updates from within the app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility: allow querying for EPUB reader &amp; sharing apps (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/epub+zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/epub+zip" />
        </intent>
    </queries>

    <application
        android:label="Shuka"
        android:allowBackup="true"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:supportsRtl="true">

        <!-- Foreground service for downloads -->
        <!-- stopWithTask="false": keep service running even when the user swipes
             the app away from Recents so in-progress downloads are not killed. -->
        <service
            android:name="shuka.android.platforms.android.DownloadForegroundService"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- FileProvider for sharing the downloaded APK with the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.seizue.shuka.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
